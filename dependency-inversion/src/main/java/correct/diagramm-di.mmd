graph LR
    subgraph inventario[correct.inventarios]
        B[Producto]:::base
        C[RegistradorDeUso]:::abstraccion
    end

    subgraph pedidos[correct.pedidos]
        A[Pedido]:::cliente
    end

    A -->|usa| B
    A -->|implementa| C
    B -->|usa| C

    classDef cliente fill:#4A90D9,stroke:#2C5F8A,stroke-width:2px,color:#fff
    classDef base fill:#5FAD56,stroke:#3D7A36,stroke-width:2px,color:#fff
    classDef abstraccion fill:#F0AD4E,stroke:#B37A2E,stroke-width:2px,color:#fff